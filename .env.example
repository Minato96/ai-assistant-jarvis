# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Provider-agnostic LLM credentials. Point these at whichever OpenAI-compatible
# endpoint you're using right now — swap both to change provider, no code changes.
#
# DeepSeek platform directly:
#   LLM_BASE_URL=https://api.deepseek.com
#   MODEL_NAME=deepseek-chat        (or deepseek-reasoner, or whatever the exact
#                                     slug for the model you want is — check
#                                     DeepSeek's API docs for the current list)
#
# OpenRouter (once you switch over):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   MODEL_NAME=deepseek/deepseek-chat   (verify exact slug at openrouter.ai/models)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# Your numeric Telegram user id, to restrict the bot to you only.
# Leave blank for the first run: the bot logs your user_id when it sees a message
# from an unrecognized sender, then set it here and restart.
ALLOWED_TELEGRAM_USER_ID=
